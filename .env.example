APP_NAME="XISTI Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
APP_URL=https://admin.xistiapp.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_xisti_app
DB_USERNAME=xisti
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=xisti_

# --- XISTI product ---
XISTI_PRODUCT_NAME=XISTI
XISTI_TAGLINE="Fácil y Seguro"
XISTI_APP_KEY=CHANGE_ME_GENERATE_LONG_RANDOM_SECRET
XISTI_ALLOWED_ADMIN_HOST=admin.xistiapp.com
XISTI_PUBLIC_SITE_URL=https://www.xistiapp.com
XISTI_DEFAULT_COMMISSION_PERCENT=8
XISTI_FARE_NEGOTIATION_STEP=500
XISTI_DEFAULT_CITY=Medellín

# --- Firebase (FCM + RTDB) ---
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_DATABASE_URL=https://CHANGE_ME-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/xisti-admin/storage/app/firebase/service-account.json
# Optional inline credentials (prefer JSON file above)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_FCM_USER_TOPIC=XistiUser
FIREBASE_FCM_DRIVER_TOPIC=XistiDriver

# Firebase Web SDK (panel admin en navegador)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
XISTI_FIREBASE_CHAT_ADMIN_EMAIL=admin@xistiapp.com
XISTI_FIREBASE_CHAT_ADMIN_PASSWORD=

# --- Wompi (Colombia) ---
WOMPI_PUBLIC_KEY=CHANGE_ME
WOMPI_PRIVATE_KEY=CHANGE_ME
WOMPI_EVENTS_SECRET=CHANGE_ME
WOMPI_ENV=sandbox
# Shared secret for webhooks forwarded from Zimo router (optional but recommended in prod)
WOMPI_WEBHOOK_FORWARD_SECRET=

# --- Twilio Verify (OTP SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Google Maps (server-side proxy) ---
GOOGLE_MAPS_SERVER_KEY=CHANGE_ME

# --- Social login (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

FACEBOOK_REDIRECT_URI=
GOOGLE_REDIRECT_URI=

MAIL_MAILER=resend
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@xistiapp.com
MAIL_FROM_NAME=XISTI

# Resend (all transactional mail sends as noreply@xistiapp.com)
# Set only in server .env — never commit a real key (create at https://resend.com/api-keys)
RESEND_API_KEY=

# Optional overrides (defaults match MAIL_FROM_* above)
XISTI_MAIL_FROM_ADDRESS=noreply@xistiapp.com
XISTI_MAIL_FROM_NAME=XISTI
XISTI_SUPPORT_EMAIL=soporte@xistiapp.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"
